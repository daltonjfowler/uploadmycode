{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "uno-web-ide",
  "main": "src/worker.ts",

  // Keep this within ~30 days of the last real change to the Worker.
  "compatibility_date": "2026-08-31",
  // No "nodejs_compat": this Worker uses zero Node built-ins. Adding the flag
  // also forces a @types/node dependency. Add it if a later task needs it.

  // Deploy to <name>.<subdomain>.workers.dev. No custom domain yet.
  "workers_dev": true,

  "assets": {
    // The frontend. T0 ships a placeholder here; T2 builds Vite output into it.
    "directory": "./public/",
    // Lets the Worker fall back to the static site: env.ASSETS.fetch(request).
    "binding": "ASSETS",
    // API paths hit the Worker before the asset server. Everything else tries
    // a static file first and only reaches the Worker if no file matches.
    "run_worker_first": ["/api/*"],
    // No SPA rewrite and no custom 404 page. A missing file is a plain 404.
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // The arduino-cli compile service. One container, wrapped in a Durable Object
  // so the Worker can address it. All three blocks below describe the same
  // class and must agree on "CompilerContainer".
  "containers": [
    {
      "class_name": "CompilerContainer",
      "image": "./container/Dockerfile",
      // Explicit so "COPY package.json server.js" resolves against container/.
      "image_build_context": "./container",
      // 1/4 vCPU, 1 GiB memory, 4 GB disk. Enough for avr-gcc; see PLAN.md cost caps.
      "instance_type": "basic",
      // Cost cap. Requests past this error, and the Worker turns that into a
      // "compiler is busy" message. Raise to 2 only if a real class saturates it.
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "COMPILER",
        "class_name": "CompilerContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CompilerContainer"]
    }
  ]
}
