{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "uploadmycode",
  "main": "src/worker.ts",

  // Keep this within ~30 days of the last real change to the Worker.
  "compatibility_date": "2026-08-31",
  // No "nodejs_compat": this Worker uses zero Node built-ins. Adding the flag
  // also forces a @types/node dependency. Add it if a later task needs it.

  // Deploy to <name>.<subdomain>.workers.dev. No custom domain yet.
  "workers_dev": true,

  // Custom domain, registered at Cloudflare Registrar on this account (2026-09-01).
  // This is the final origin for docs/CHROMEBOOK-CHECKLIST.md. workers.dev stays on as a fallback.
  "routes": [
    { "pattern": "uploadmycode.com", "custom_domain": true },
    { "pattern": "www.uploadmycode.com", "custom_domain": true }
  ],

  "assets": {
    // The frontend. T0 ships a placeholder here; T2 builds Vite output into it.
    "directory": "./public/",
    // Lets the Worker fall back to the static site: env.ASSETS.fetch(request).
    "binding": "ASSETS",
    // EVERY request runs the Worker first, including one for a static file.
    // That is what lets src/headers.ts put the security headers on the editor,
    // the teacher page and every icon, and what lets the http -> https redirect
    // catch a student who typed the bare domain. With the old ["/api/*"] the
    // asset server answered "/" by itself and the Worker never ran, so nothing
    // but /api/* was ever stamped. The Worker still serves the files: the
    // fall-through in src/worker.ts is env.ASSETS.fetch(request), and
    // not_found_handling below still decides what a missing file gets.
    "run_worker_first": true,
    // No SPA rewrite and no custom 404 page. A missing file is a plain 404.
    "not_found_handling": "none"
  },

  // Rolling class phrase lives here (T5). Key "phrase", written with an expirationTtl by the
  // teacher endpoint; read on every compile.
  "kv_namespaces": [
    { "binding": "CLASS_KV", "id": "1826452392d7425b96e48aa005f9be77" }
  ],

  "vars": {
    // Optional in-person lock (T5). Empty = off, and the site works from anywhere as long as
    // the class phrase is right. Set it to a comma-separated list of the school's public
    // egress ranges (IPv4 and/or IPv6, e.g. "203.0.113.0/24,2001:db8:1234::/48") and every
    // compile from another address is refused. How to get the ranges: docs/DEPLOY.md.
    // A var, not a secret: it is not sensitive and it belongs in version control.
    "ALLOWED_CIDRS": ""
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // The arduino-cli compile service, wrapped in a Durable Object so the Worker
  // can address it. This block, the COMPILER binding and the "v1" migration all
  // describe the same class and must agree on "CompilerContainer".
  "containers": [
    {
      "class_name": "CompilerContainer",
      "image": "./container/Dockerfile",
      // Explicit so "COPY package.json server.js" resolves against container/.
      "image_build_context": "./container",
      // 1/4 vCPU, 1 GiB memory, 4 GB disk. Enough for avr-gcc; see PLAN.md cost caps.
      "instance_type": "basic",
      // TWO containers, so a class that all presses Compile at once has two
      // sketches building at once instead of one. The Worker routes each compile
      // to the least-loaded one (src/queue.ts), and that routing sends everything
      // to container 0 whenever only one compile is in flight — so the second
      // instance stays asleep and bills nothing except during a real burst. This
      // MUST equal CONTAINER_COUNT in src/queue.ts; raise the two together.
      "max_instances": 2
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "COMPILER",
        "class_name": "CompilerContainer"
      },
      // The rate limiters and the teacher-key guard, in a Durable Object of
      // their own with NO container attached. They are counted here rather
      // than in CompilerContainer because the Container base class renews its
      // sleep timer on every touch of its object, so counting a wrong teacher
      // key there would keep the compiler awake, and billing, on junk traffic.
      // See src/worker.ts and docs/DEPLOY.md section 7.
      {
        "name": "COUNTERS",
        "class_name": "Counters"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CompilerContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Counters"]
    }
  ]
}
